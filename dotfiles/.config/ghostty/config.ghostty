font-family = JetBrainsMono Nerd Font
font-size = 14
adjust-cell-height = 2

window-padding-x = 12
window-padding-y = 12

# Optional colors generated outside this project by DMS.
# The question mark permits installation without a DMS theme file.
config-file = ?themes/dankcolors

cursor-style = block
cursor-style-blink = true
mouse-hide-while-typing = true
